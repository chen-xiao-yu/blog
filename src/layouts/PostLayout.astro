---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  date: Date;
  tags: string[];
  description?: string;
  prevPost: { slug: string; title: string } | null;
  nextPost: { slug: string; title: string } | null;
}

const { title, date, tags, description, prevPost, nextPost } = Astro.props;

const formatDate = (d: Date) => d.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <!-- 阅读进度条 -->
  <div class="reading-progress" id="reading-progress"></div>

  <article class="post-article">
    <header class="post-hero">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span class="dot"></span>
        {tags.map((tag, i) => (
          <>
            <a href={`/tags/${tag}`} class="tag">{tag}</a>
            {i < tags.length - 1 && <span class="dot"></span>}
          </>
        ))}
      </div>
    </header>

    <div class="post-content-card">
      <div class="prose" id="prose-content">
        <slot />
      </div>
    </div>

    <!-- 分享区域 -->
    <div class="share-section">
      <div class="share-label">分享这篇文章</div>
      <div class="share-actions">
        <button class="share-btn" id="btn-copy" title="复制链接">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span>复制链接</span>
        </button>
        <button class="share-btn" id="btn-qrcode" title="扫码分享">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/><path d="M20 14v3h-3"/><path d="M20 20h-3"/></svg>
          <span>扫码分享</span>
        </button>
        <button class="share-btn" id="btn-native" title="系统分享" style="display:none">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          <span>分享</span>
        </button>
      </div>

      <!-- 文章二维码弹窗 -->
      <div class="qrcode-modal" id="qrcode-modal">
        <div class="qrcode-card">
          <div class="qrcode-header">
            <span>扫码阅读 & 分享</span>
            <button class="qrcode-close" id="qrcode-close">&times;</button>
          </div>
          <div class="qrcode-body" id="qrcode-container"></div>
          <p class="qrcode-tip"><strong>微信扫码 → 点右上角 ··· → 分享到朋友圈</strong></p>
        </div>
      </div>
    </div>

    <!-- 公众号关注卡片 -->
    <div class="wechat-follow-card">
      <div class="wechat-follow-icon">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.295.295a.328.328 0 0 0 .186-.059l2.143-1.242a.59.59 0 0 1 .338-.104c.058 0 .116.008.173.023.811.221 1.668.335 2.55.335 3.94 0 7.127-2.533 7.727-5.838.016-.093.024-.188.024-.283C16.213 6.477 12.8 2.188 8.691 2.188Zm-2.54 4.237a.883.883 0 1 1 0 1.766.883.883 0 0 1 0-1.766Zm5.08 0a.883.883 0 1 1 0 1.766.883.883 0 0 1 0-1.766Z"/>
          <path d="M22.004 9.897c0-3.5-3.352-6.34-7.487-6.34-.28 0-.556.014-.828.04 1.265 1.193 2.023 2.797 2.023 4.56 0 3.673-3.26 6.653-7.294 6.653-.183 0-.364-.007-.544-.02.854 2.466 3.6 4.282 6.796 4.282.808 0 1.58-.106 2.31-.3a.543.543 0 0 1 .156-.023c.1 0 .2.027.289.079l1.944 1.126a.297.297 0 0 0 .169.053c.15 0 .268-.118.268-.268a.52.52 0 0 0-.044-.193l-.353-1.34a.534.534 0 0 1 .193-.604c1.664-1.225 2.702-3.03 2.702-5.005Z"/>
        </svg>
      </div>
      <div class="wechat-follow-body">
        <div class="wechat-follow-name">下辈子不写程序</div>
        <div class="wechat-follow-desc">觉得有收获？关注我的微信公众号，获取更多原创技术内容 ✨</div>
      </div>
      <div class="wechat-follow-action">
        <button class="wechat-follow-btn" id="btn-wechat-qr">
          关注公众号
        </button>
      </div>

      <!-- 公众号二维码弹窗 -->
      <div class="qrcode-modal" id="wechat-qr-modal">
        <div class="qrcode-card">
          <div class="qrcode-header">
            <span>扫码关注公众号</span>
            <button class="qrcode-close" id="wechat-qr-close">&times;</button>
          </div>
          <div class="qrcode-body wechat-qr-body">
            <img src="/wechat-qr.jpg" alt="下辈子不写程序 公众号二维码" class="wechat-qr-img" />
          </div>
          <p class="qrcode-tip"><strong>微信扫码或搜索「下辈子不写程序」即可关注</strong></p>
        </div>
      </div>
    </div>

    <!-- 上一篇 / 下一篇 -->
    {(prevPost || nextPost) && (
      <nav class="post-siblings">
        <div class="post-sibling-item post-sibling-prev">
          {prevPost ? (
            <a href={`/posts/${prevPost.slug}`} class="post-sibling-link">
              <span class="post-sibling-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                上一篇
              </span>
              <span class="post-sibling-title">{prevPost.title}</span>
            </a>
          ) : <div />}
        </div>
        <div class="post-sibling-divider" />
        <div class="post-sibling-item post-sibling-next">
          {nextPost ? (
            <a href={`/posts/${nextPost.slug}`} class="post-sibling-link post-sibling-link-next">
              <span class="post-sibling-label">
                下一篇
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </span>
              <span class="post-sibling-title">{nextPost.title}</span>
            </a>
          ) : <div />}
        </div>
      </nav>
    )}

    <nav class="post-nav">
      <a href="/">← 返回首页</a>
    </nav>
  </article>

  <!-- 回到顶部按钮 -->
  <button class="back-to-top" id="back-to-top" aria-label="回到顶部" title="回到顶部">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

  <script>
    // ===== 阅读进度条 =====
    const progressBar = document.getElementById('reading-progress');
    function updateProgress() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.min(100, (scrollTop / docHeight) * 100) : 0;
      if (progressBar) progressBar.style.width = pct + '%';
    }
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    // ===== 回到顶部 =====
    const backTopBtn = document.getElementById('back-to-top');
    function toggleBackTop() {
      if (backTopBtn) {
        backTopBtn.classList.toggle('visible', window.scrollY > 400);
      }
    }
    window.addEventListener('scroll', toggleBackTop, { passive: true });
    backTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // ===== 代码块一键复制 =====
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const btn = document.createElement('button');
      btn.className = 'code-copy-btn';
      btn.title = '复制代码';
      btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>复制</span>';
      wrapper.appendChild(btn);

      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code?.textContent || (pre as HTMLElement).textContent || '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
        const span = btn.querySelector('span');
        if (span) {
          span.textContent = '已复制';
          btn.classList.add('copied');
          setTimeout(() => { span.textContent = '复制'; btn.classList.remove('copied'); }, 2000);
        }
      });
    });

    // ===== 复制文章链接 =====
    document.getElementById('btn-copy')?.addEventListener('click', async () => {
      const url = window.location.href;
      try { await navigator.clipboard.writeText(url); }
      catch {
        const input = document.createElement('input');
        input.value = url; document.body.appendChild(input);
        input.select(); document.execCommand('copy'); document.body.removeChild(input);
      }
      const span = document.getElementById('btn-copy')?.querySelector('span');
      if (span) { const orig = span.textContent; span.textContent = '已复制 ✓'; setTimeout(() => { if(span) span.textContent = orig; }, 2000); }
    });

    // ===== Web Share API =====
    const nativeBtn = document.getElementById('btn-native') as HTMLElement | null;
    if (navigator.share && nativeBtn) {
      nativeBtn.style.display = '';
      nativeBtn.addEventListener('click', () => navigator.share({ title: document.title, url: window.location.href }).catch(() => {}));
    }

    // ===== 文章页二维码 =====
    const modal = document.getElementById('qrcode-modal');
    const qrcodeContainer = document.getElementById('qrcode-container');
    document.getElementById('btn-qrcode')?.addEventListener('click', async () => {
      if (!qrcodeContainer?.hasChildNodes()) {
        const qrcode = await import('qrcode-generator');
        const qr = qrcode.default(0, 'M');
        qr.addData(window.location.href);
        qr.make();
        const size = qr.getModuleCount();
        const cellSize = Math.max(4, Math.floor(200 / size));
        qrcodeContainer.innerHTML = qr.createSvgTag(cellSize, 2);
        const svg = qrcodeContainer.querySelector('svg');
        if (svg) { svg.style.width = '200px'; svg.style.height = '200px'; svg.style.margin = '0 auto'; svg.style.display = 'block'; }
      }
      modal!.classList.add('open');
    });
    document.getElementById('qrcode-close')?.addEventListener('click', () => modal!.classList.remove('open'));
    modal?.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('open'); });

    // ===== 公众号二维码弹窗 =====
    const wechatModal = document.getElementById('wechat-qr-modal');
    document.getElementById('btn-wechat-qr')?.addEventListener('click', () => wechatModal!.classList.add('open'));
    document.getElementById('wechat-qr-close')?.addEventListener('click', () => wechatModal!.classList.remove('open'));
    wechatModal?.addEventListener('click', (e) => { if (e.target === wechatModal) wechatModal.classList.remove('open'); });

    // ===== ESC 键关闭所有弹窗 =====
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        modal?.classList.remove('open');
        wechatModal?.classList.remove('open');
      }
    });
  </script>
</BaseLayout>
